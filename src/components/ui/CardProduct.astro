---
import Button from "./Button.astro";

const styleButton = {
  width: "9.5em",
  borderRadius: "0",
  position: "absolute",
  bottom: "0",
  right: "0",
  textTransform: "uppercase",
};
---

<article class="product">
  <div class="product__img">
    <span class="product__destac">Destacado</span>
    <img src="/images/producto.svg" alt="" />
  </div>
  <div class="product__text">
    <p>Kinergy Eco K425 175/80</p>
    <p>R14<span>Hankook</span></p>
    <Button styleLine={styleButton}>Cotizar</Button>
  </div>
</article>
