---
const { product } = Astro.props;
---

<div
  class="bg-surface rounded-xl p-6 flex gap-6
         shadow hover:shadow-lg transition-shadow duration-300"
>
  <!-- IMAGEN -->
  <div
    class="bg-white rounded-lg p-4 w-36 h-36
           flex items-center justify-center flex-shrink-0"
  >
    <img
      src={product.image}
      alt={product.name}
      class="max-h-full object-contain"
      loading="lazy"
    />
  </div>

  <!-- INFO -->
  <div class="flex-1">
    <span class="text-red-500 font-semibold text-sm uppercase tracking-wide">
      {product.brand}
    </span>

    <h3 class="text-white font-bold mt-1 text-lg leading-snug">
      {product.name}
    </h3>

    <p class="text-gray-300 mt-2 font-medium">
      {product.size}
    </p>

    <div class="flex flex-wrap gap-4 mt-4 text-sm text-gray-400">
      <span>🧱 Carga Máx: {product.load} Kg</span>
      <span>⚡ Vel. Máx: {product.speed}</span>
    </div>
  </div>
</div>
