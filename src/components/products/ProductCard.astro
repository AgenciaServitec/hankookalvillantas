---
const { product } = Astro.props;

const WHATSAPP_PHONE = "51943581507";
const message = `Hola, quiero cotizar la llanta ${product.name} - ${product.size}`;
const whatsappUrl = `https://api.whatsapp.com/send?phone=${WHATSAPP_PHONE}&text=${encodeURIComponent(message)}`;
---

<div
  class="bg-surface rounded-xl p-6 flex items-center gap-6 shadow hover:shadow-lg transition"
>
  <!-- IMAGEN -->
  <div
    class="bg-white rounded-lg p-4 w-36 h-36 flex items-center justify-center flex-shrink-0"
  >
    <img
      src={product.image}
      alt={product.name}
      class="max-h-full object-contain"
    />
  </div>

  <!-- INFO -->
  <div class="flex-1">
    <span class="text-red-500 font-semibold text-sm uppercase">
      {product.brand}
    </span>

    <h3 class="text-white font-bold mt-1 text-lg">
      {product.name}
    </h3>

    <p class="text-gray-300 mt-2 font-medium">
      {product.size}
    </p>

    <div class="flex gap-4 mt-4 text-sm text-gray-400">
      <span>🧱 Carga Máx: {product.load} Kg</span>
      <span>⚡ Vel. Máx: {product.speed}</span>
    </div>
  </div>

  <!-- BOTÓN DERECHA -->
  <a
    href={whatsappUrl}
    target="_blank"
    rel="noopener"
    class="flex items-center justify-center gap-2
           bg-red-600 hover:bg-red-700
           text-white font-semibold
           px-6 py-3 rounded-lg
           transition-colors whitespace-nowrap"
  >
    <svg
      class="w-5 h-5"
      viewBox="0 0 448 512"
      fill="currentColor"
      aria-hidden="true"
    >
      <path
        d="M380.9 97.1C339-3.1 214.8-33.7 123.6 18.7 32.4 71.1-8.1 192.1 35.7 288.3L0 416l132.1-34.7c91.6 49.5 206.5 17.9 254.6-73.4 48.1-91.3 11.4-205.1-75.8-259.8z"
      ></path>
    </svg>
    <span>Cotizar por WhatsApp</span>
  </a>
</div>
