---
import Footer from "./Footer.astro";
import Header from "./Header.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  image?: string;
  canonicalURL?: string;
}

const {
  title,
  description = "Encuentra las mejores llantas para tu vehículo. Calidad, seguridad y los mejores precios del mercado en un solo lugar. ¡Cotiza tus llantas hoy mismo!",
  image = "/og-default.png",
  canonicalURL = Astro.url.href,
} = Astro.props;

const makeImageUrl = (img: string) => new URL(img, Astro.site ?? Astro.url);
const finalImageUrl = makeImageUrl(image);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />

    <link rel="canonical" href={canonicalURL} />

    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta
      property="og:image"
      content="https://www.facilcar.net/og-default.png"
    />
    <meta property="og:site_name" content={title} />
    <meta property="og:locale" content="es_PE" />

    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={Astro.url.href} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta
      property="twitter:image"
      content="https://www.facilcar.net/og-default.png"
    />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  </head>
  <body>
    <div class="flex min-h-screen flex-col relative">
      <Header />
      <main class="grow">
        <slot />
      </main>
      <Footer />

      <a
        href="https://wa.me/51943581507?text=Hola,%20quisiera%20consultar%20por%20la%20venta%20de%20llantas."
        target="_blank"
        rel="noopener noreferrer"
        class="fixed bottom-6 right-6 z-50 bg-[#25D366] hover:bg-[#20ba5a] text-white p-4 rounded-full shadow-lg transition-all duration-300 hover:scale-110 flex items-center justify-center group"
        aria-label="Contactar por WhatsApp"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="28"
          height="28"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="icon icon-tabler icon-tabler-brand-whatsapp fill-current"
        >
          <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
          <path d="M3 21l1.65 -3.8a9 9 0 1 1 3.4 2.9l-5.05 .9"></path>
          <path
            d="M9 10a.5 .5 0 0 0 1 0v-1a.5 .5 0 0 0 -1 0v1a5 5 0 0 0 5 5h1a.5 .5 0 0 0 0 -1h-1a.5 .5 0 0 0 0 1"
          ></path>
        </svg>
      </a>
    </div>
  </body>
</html>
