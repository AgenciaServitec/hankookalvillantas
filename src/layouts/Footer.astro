---
import ContentWidth from "../components/ui/ContentWidth.astro";
---
<footer class="bg-surface text-gray-300">
  <ContentWidth>
    <div class="py-14 grid md:grid-cols-3 gap-10">
      <!-- INFO -->
      <div>
        <img src="/logo.webp" class="h-10 mb-4" />
        <p class="text-sm leading-relaxed">
          Brindamos atención empática y profesional. Garantizamos nuestros
          productos y servicios.
        </p>
      </div>


      <!-- CONTACTO -->
      <div>
        <h3 class="text-white font-bold mb-4">Contacto</h3>

        <ul class="space-y-3 text-sm">
          <li class="flex items-center gap-3">
            <img
              src="/svg/phone.svg"
              alt="Teléfono"
              class="w-4 h-4"
            />
            <span>967787227</span>
          </li>

          <li class="flex items-center gap-3">
            <img
              src="/svg/email.svg"
              alt="Email"
              class="w-4 h-4"
            />
            <span>ventas3@hankookalvillantas.com</span>
          </li>

          <li class="flex items-center gap-3">
            <img
              src="/svg/location.svg"
              alt="Ubicación"
              class="w-4 h-4"
            />
            <span>Lima Metropolitana</span>
          </li>

          <li class="flex items-center gap-3">
            <img
              src="/svg/time.svg"
              alt="Horario"
              class="w-4 h-4"
            />
            <span>Lun–Vie: 09:00 – 19:00</span>
          </li>
        </ul>
      </div>


      <!-- LINKS -->
      <div>
        <h3 class="text-white font-bold mb-4">Información</h3>
        <ul class="space-y-2 text-sm">
          <li><a href="/about" class="hover:text-orange-500">Nosotros</a></li>
          <li><a href="/products" class="hover:text-orange-500">Productos</a></li>
          <li><a href="/contact" class="hover:text-orange-500">Contacto</a></li>
          <li><a href="/terms" class="hover:text-orange-500">Términos</a></li>
        </ul>
      </div>
    </div>

    <!-- COPYRIGHT -->

  </ContentWidth>

  <div class="border-t border-white/10 text-center text-sm py-5">
    © 2026 Hankook Alvillantas. Todos los derechos reservados. Desarrollado por Servitec Peru.
  </div>
</footer>
