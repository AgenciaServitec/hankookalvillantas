<section
  class="relative min-h-[85vh] w-full overflow-hidden flex items-center py-20"
>
  <video
    class="absolute inset-0 w-full h-full object-cover z-0"
    src="/videos/llantas-hero.mp4"
    autoplay
    muted
    loop
    playsinline></video>

  <div class="absolute inset-0 bg-black/40 z-0"></div>

  <div class="relative z-10 w-full max-w-7xl mx-auto px-6">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <div class="max-w-xl text-white">
        <span class="text-red-500 font-extrabold uppercase tracking-tight">
          FacilCar
        </span>

        <h1 class="mt-3 text-4xl md:text-5xl font-extrabold leading-tight">
          Llantas de calidad<br />
          al mejor precio
        </h1>

        <p class="mt-4 text-gray-200">
          Venta y distribución de neumáticos con delivery gratis en Lima
          Metropolitana.
        </p>

        <div class="mt-6 flex flex-wrap gap-4">
          <a
            href="/productos"
            class="group inline-flex items-center gap-2
                   bg-red-600 hover:bg-red-700
                   px-6 py-3 rounded font-bold text-white
                   transition-colors duration-300"
          >
            <svg
              class="w-5 h-5"
              viewBox="0 0 512 512"
              fill="currentColor"
              aria-hidden="true"
            >
              <path
                d="M256 32C132.3 32 32 132.3 32 256s100.3 224 224 224 224-100.3 224-224S379.7 32 256 32zm0 64c88.2 0 160 71.8 160 160s-71.8 160-160 160S96 344.2 96 256 167.8 96 256 96zm0 48c-61.9 0-112 50.1-112 112s50.1 112 112 112 112-50.1 112-112-50.1-112-112-112z"
              ></path>
            </svg>
            <span>VER PRODUCTOS</span>
          </a>

          <a
            href="https://api.whatsapp.com/send?phone=51943581507&text=Me%20interesa%20saber%20m%C3%A1s%20sobre%20sus%20productos"
            target="_blank"
            rel="noopener"
            class="group inline-flex items-center gap-2
                   border border-white
                   px-6 py-3 rounded font-bold text-white
                   hover:bg-white hover:text-black
                   transition-colors duration-300"
          >
            <svg
              class="w-5 h-5"
              viewBox="0 0 448 512"
              fill="currentColor"
              aria-hidden="true"
            >
              <path
                d="M380.9 97.1C339-3.1 214.8-33.7 123.6 18.7 32.4 71.1-8.1 192.1 35.7 288.3L0 416l132.1-34.7c91.6 49.5 206.5 17.9 254.6-73.4 48.1-91.3 11.4-205.1-75.8-259.8z"
              ></path>
            </svg>
            <span>CONTACTO</span>
          </a>
        </div>
      </div>

      <div class="flex justify-center lg:justify-end w-full">
        <div class="bg-white p-6 md:p-8 rounded-lg shadow-2xl w-full max-w-md">
          <p
            class="text-gray-900 text-center mb-6 text-xl font-extrabold uppercase"
          >
            Cotiza tus llantas
          </p>

          <form id="lead-form" class="space-y-4">
            <div>
              <label
                for="fullName"
                class="block text-sm font-semibold text-gray-700 mb-1"
                >Nombre Completo</label
              >
              <input
                id="fullName"
                name="fullName"
                type="text"
                placeholder="Tu nombre"
                required
                class="w-full px-4 py-3 bg-gray-50 border border-gray-300 rounded-md text-gray-900 focus:outline-none focus:border-2 focus:border-red-500 placeholder:text-gray-400 transition-colors"
              />
            </div>

            <div>
              <label
                for="email"
                class="block text-sm font-semibold text-gray-700 mb-1"
                >Correo Electrónico</label
              >
              <input
                id="email"
                name="email"
                type="email"
                placeholder="ejemplo@correo.com"
                required
                class="w-full px-4 py-3 bg-gray-50 border border-gray-300 rounded-md text-gray-900 focus:outline-none focus:border-2 focus:border-red-500 placeholder:text-gray-400 transition-colors"
              />
            </div>

            <div>
              <label
                for="whatsapp"
                class="block text-sm font-semibold text-gray-700 mb-1"
                >WhatsApp</label
              >
              <input
                id="whatsapp"
                name="whatsapp"
                type="tel"
                placeholder="+51 900 000 000"
                required
                class="w-full px-4 py-3 bg-gray-50 border border-gray-300 rounded-md text-gray-900 focus:outline-none focus:border-2 focus:border-red-500 placeholder:text-gray-400 transition-colors"
              />
            </div>

            <div>
              <label
                for="message"
                class="block text-sm font-semibold text-gray-700 mb-1"
                >Mensaje</label
              >
              <textarea
                id="message"
                name="message"
                placeholder="Hola, busco llantas para mi vehículo. Medidas: 205/55R16..."
                required
                class="w-full px-4 py-3 bg-gray-50 border border-gray-300 rounded-md text-gray-900 focus:outline-none focus:border-2 focus:border-red-500 placeholder:text-gray-400 transition-colors"
                rows="3"></textarea>
            </div>

            <button
              id="submit-btn"
              type="submit"
              class="w-full mt-2 bg-red-600 hover:bg-red-700 text-white font-bold text-sm py-4 rounded-md transition-all transform hover:scale-[1.02] active:scale-[0.98] uppercase cursor-pointer"
            >
              <span id="btn-text">Solicitar Cotización</span>
            </button>
          </form>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById("lead-form") as HTMLFormElement;
  const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement;
  const btnText = document.getElementById("btn-text");

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();

    if (!submitBtn || !btnText) return;

    submitBtn.disabled = true;
    btnText.textContent = "Enviando solicitud...";

    const formData = new FormData(form);

    const entryPayload = {
      category: "contact",
      hostname: "facilcar.net",
      message: formData.get("message") || "Consulta sobre llantas",
      subject: "Nueva solicitud de cotización - Web FacilCar",
      client: {
        fullName: formData.get("fullName"),
        email: formData.get("email"),
        phone: {
          prefix: "+51",
          number: formData.get("whatsapp"),
        },
      },
    };

    try {
      const response = await fetch(
        "https://api-servitec-peru.web.app/entries/contact",
        {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify(entryPayload),
        },
      );

      const result = await response.json();

      if (!response.ok) {
        console.error("Error de validación:", result.details);
        throw new Error(result.error || "Error al procesar la data.");
      }

      form.reset();
      window.location.href = "/gracias";
      alert(
        "¡Gracias! Tu mensaje ha sido enviado correctamente. Te contactaremos pronto.",
      );

      submitBtn.disabled = false;
      btnText.textContent = "Solicitar Cotización";
    } catch (error) {
      console.error("Error detallado:", error);
      alert(
        "Hubo un problema al enviar tu mensaje. Por favor intenta nuevamente.",
      );

      submitBtn.disabled = false;
      btnText.textContent = "Solicitar Cotización";
    }
  });
</script>
