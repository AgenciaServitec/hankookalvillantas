---
import ContentWidth from "../components/ui/ContentWidth.astro";

const {
  whatsappHref = "https://api.whatsapp.com/send?phone=51967787227&text=Hola,%20quiero%20cotizar%20llantas",
} = Astro.props;

const steps = [
  {
    title: "Busca tu llanta",
    description: "Por tu auto (año/marca/modelo) o por medida.",
    icon: "search",
  },
  {
    title: "Cotiza por WhatsApp",
    description: "Te confirmamos stock, precio y disponibilidad.",
    icon: "whatsapp",
  },
  {
    title: "Confirmas el pago",
    description: "Tarjeta, Yape/Plin o transferencia (según disponibilidad).",
    icon: "card",
  },
  {
    title: "Entrega o instalación",
    description: "Delivery coordinado o instalación (si aplica).",
    icon: "truck",
  },
];

const icons: Record<string, string> = {
  search: `
    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
      <path d="M10 18a8 8 0 1 1 5.293-14.05A8 8 0 0 1 10 18m0-2a6 6 0 1 0-4.243-10.243A6 6 0 0 0 10 16m8.707 6.121l-4.396-4.396l1.414-1.414l4.396 4.396z"/>
    </svg>
  `,
  whatsapp: `
    <svg width="20" height="20" viewBox="0 0 640 640" fill="currentColor">
      <path d="M476.9 161.1C435 119.1 379.2 96 319.9 96C197.5 96 97.9 195.6 97.9 318C97.9 357.1 108.1 395.3 127.5 429L96 544L213.7 513.1C246.1 530.8 282.6 540.1 319.8 540.1C442.2 540.1 544 440.5 544 318.1C544 258.8 518.8 203.1 476.9 161.1z"/>
    </svg>
  `,
  card: `
    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
      <path d="M3 6a3 3 0 0 1 3-3h12a3 3 0 0 1 3 3v2H3zm0 4h21v8a3 3 0 0 1-3 3H6a3 3 0 0 1-3-3zm4 6h6v2H7z"/>
    </svg>
  `,
  truck: `
    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
      <path d="M3 7a2 2 0 0 1 2-2h10v9h-2.1a3.5 3.5 0 0 0-6.8 0H3zm14 1h2.8l2.2 3.5V14h-2.1a3.5 3.5 0 0 0-6.8 0H17zM8.5 19a1.5 1.5 0 1 1 0-3a1.5 1.5 0 0 1 0 3m10 0a1.5 1.5 0 1 1 0-3a1.5 1.5 0 0 1 0 3"/>
    </svg>
  `,
};

const getIcon = (name: string) => icons[name] ?? "";
---

<section class="bg-surface border-y border-white/10 mb-20">
  <ContentWidth>
    <div class="py-14">
      <div class="flex flex-col gap-2">
        <h2 class="text-2xl md:text-3xl font-semibold text-white">
          ¿Cómo comprar?
        </h2>
        <p class="text-gray-400 max-w-2xl">
          Un proceso simple, rápido y guiado por un asesor para que elijas la
          medida correcta.
        </p>
      </div>

      <div class="relative mt-10">
        <div
          aria-hidden="true"
          class="hidden md:block absolute left-6 right-6 top-[28px] h-px bg-white/10"
        >
        </div>

        <ol class="grid grid-cols-1 md:grid-cols-4 gap-4">
          {
            steps.map((s, idx) => (
              <li class="relative">
                <div class="rounded-2xl border border-white/10 bg-surface-alt p-5 h-full">
                  <div class="flex items-start gap-4">
                    <div class="relative">
                      <div class="flex h-12 w-12 items-center justify-center rounded-xl border border-white/10 bg-surface text-red-600">
                        <span set:html={getIcon(s.icon)} />
                      </div>

                      <span class="absolute -right-2 -top-2 h-6 min-w-6 px-1.5 inline-flex items-center justify-center rounded-full bg-red-600 text-white text-xs font-bold">
                        {idx + 1}
                      </span>
                    </div>

                    <div class="min-w-0">
                      <h3 class="font-semibold text-white">{s.title}</h3>
                      <p class="mt-1 text-sm text-gray-400">{s.description}</p>
                    </div>
                  </div>
                </div>

                {idx < steps.length - 1 && (
                  <div
                    aria-hidden="true"
                    class="md:hidden ml-6 mt-3 h-5 w-px bg-white/10"
                  />
                )}
              </li>
            ))
          }
        </ol>
      </div>

      <div class="mt-8 flex flex-col md:flex-row md:items-center gap-3">
        <a
          href={whatsappHref}
          target="_blank"
          rel="noopener"
          class="inline-flex items-center justify-center gap-2
                 rounded-xl bg-red-600 px-5 py-3
                 text-sm font-semibold text-white
                 hover:bg-red-700 active:bg-red-800
                 transition-colors"
        >
          <svg
            class="w-6 h-6"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 640 640"
            fill="currentColor"
          >
            <path
              d="M476.9 161.1C435 119.1 379.2 96 319.9 96C197.5 96 97.9 195.6 97.9 318C97.9 357.1 108.1 395.3 127.5 429L96 544L213.7 513.1C246.1 530.8 282.6 540.1 319.8 540.1C442.2 540.1 544 440.5 544 318.1C544 258.8 518.8 203.1 476.9 161.1z"
            ></path>
          </svg>
          <span>Cotizar por WhatsApp</span>
        </a>

        <div
          class="flex-1 rounded-xl border border-white/10 bg-surface-alt px-5 py-3 text-sm text-gray-400"
        >
          Tip: si no sabes la medida, envíanos una foto del costado de tu llanta
          y te guiamos.
        </div>
      </div>
    </div>
  </ContentWidth>
</section>
