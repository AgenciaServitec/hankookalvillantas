---
import ContentWidth from "../components/ui/ContentWidth.astro";

const { whatsappHref = "#" } = Astro.props;

const steps = [
  {
    title: "Busca tu llanta",
    description: "Por tu auto (año/marca/modelo) o por medida.",
    icon: "search",
  },
  {
    title: "Cotiza por WhatsApp",
    description: "Te confirmamos stock, precio y disponibilidad.",
    icon: "whatsapp",
  },
  {
    title: "Confirmas el pago",
    description: "Tarjeta, Yape/Plin o transferencia (según disponibilidad).",
    icon: "card",
  },
  {
    title: "Entrega o instalación",
    description: "Delivery coordinado o instalación (si aplica).",
    icon: "truck",
  },
];

const icons: Record<string, string> = {
  search: `
    <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true">
      <path fill="currentColor"
        d="M10 18a8 8 0 1 1 5.293-14.05A8 8 0 0 1 10 18m0-2a6 6 0 1 0-4.243-10.243A6 6 0 0 0 10 16m8.707 6.121l-4.396-4.396l1.414-1.414l4.396 4.396z"
      />
    </svg>
  `,
  whatsapp: `
    <svg width="20" height="20" viewBox="0 0 640 640" aria-hidden="true">
      <path fill="currentColor"
        d="M476.9 161.1C435 119.1 379.2 96 319.9 96C197.5 96 97.9 195.6 97.9 318C97.9 357.1 108.1 395.3 127.5 429L96 544L213.7 513.1C246.1 530.8 282.6 540.1 319.8 540.1L319.9 540.1C442.2 540.1 544 440.5 544 318.1C544 258.8 518.8 203.1 476.9 161.1zM319.9 502.7C286.7 502.7 254.2 493.8 225.9 477L219.2 473L149.4 491.3L168 423.2L163.6 416.2C145.1 386.8 135.4 352.9 135.4 318C135.4 216.3 218.2 133.5 320 133.5C369.3 133.5 415.6 152.7 450.4 187.6C485.2 222.5 506.6 268.8 506.5 318.1C506.5 419.9 421.6 502.7 319.9 502.7zM421.1 364.5C415.6 361.7 388.3 348.3 383.2 346.5C378.1 344.6 374.4 343.7 370.7 349.3C367 354.9 356.4 367.3 353.1 371.1C349.9 374.8 346.6 375.3 341.1 372.5C308.5 356.2 287.1 343.4 265.6 306.5C259.9 296.7 271.3 297.4 281.9 276.2C283.7 272.5 282.8 269.3 281.4 266.5C280 263.7 268.9 236.4 264.3 225.3C259.8 214.5 255.2 216 251.8 215.8C248.6 215.6 244.9 215.6 241.2 215.6C237.5 215.6 231.5 217 226.4 222.5C221.3 228.1 207 241.5 207 268.8C207 296.1 226.9 322.5 229.6 326.2C232.4 329.9 268.7 385.9 324.4 410C359.6 425.2 373.4 426.5 391 423.9C401.7 422.3 423.8 410.5 428.4 397.5C433 384.5 433 373.4 431.6 371.1C430.3 368.6 426.6 367.2 421.1 364.5z"
      />
    </svg>
  `,
  card: `
    <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true">
      <path fill="currentColor"
        d="M3 6a3 3 0 0 1 3-3h12a3 3 0 0 1 3 3v2H3zm0 4h21v8a3 3 0 0 1-3 3H6a3 3 0 0 1-3-3zm4 6h6v2H7z"
      />
    </svg>
  `,
  truck: `
    <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true">
      <path fill="currentColor"
        d="M3 7a2 2 0 0 1 2-2h10v9h-2.1a3.5 3.5 0 0 0-6.8 0H3zm14 1h2.8l2.2 3.5V14h-2.1a3.5 3.5 0 0 0-6.8 0H17zM8.5 19a1.5 1.5 0 1 1 0-3a1.5 1.5 0 0 1 0 3m10 0a1.5 1.5 0 1 1 0-3a1.5 1.5 0 0 1 0 3"
      />
    </svg>
  `,
};

const getIcon = (name: string) => icons[name] ?? "";
---

<section class="bg-surface border-y border-border mb-20">
  <ContentWidth>
    <div class="py-14">
      <div class="flex flex-col gap-2">
        <h2 class="text-2xl md:text-3xl font-semibold text-foreground">
          ¿Cómo comprar?
        </h2>
        <p class="text-muted-2 max-w-2xl">
          Un proceso simple, rápido y guiado por un asesor para que elijas la
          medida correcta.
        </p>
      </div>

      <div class="relative mt-10">
        <div
          aria-hidden="true"
          class="hidden md:block absolute left-6 right-6 top-[28px] h-px bg-border"
        >
        </div>

        <ol class="grid grid-cols-1 md:grid-cols-4 gap-4">
          {
            steps.map((s, idx) => (
              <li class="relative">
                <div class="rounded-2xl border border-border bg-surface-alt p-5 h-full">
                  <div class="flex items-start gap-4">
                    <div class="relative">
                      <div class="flex h-12 w-12 items-center justify-center rounded-xl border border-border bg-surface text-foreground">
                        <span set:html={getIcon(s.icon)} />
                      </div>

                      <span class="absolute -right-2 -top-2 h-6 min-w-6 px-1.5 inline-flex items-center justify-center rounded-full bg-primary text-white text-xs font-bold">
                        {idx + 1}
                      </span>
                    </div>

                    <div class="min-w-0">
                      <h3 class="font-semibold text-foreground">{s.title}</h3>
                      <p class="mt-1 text-sm text-muted-2">{s.description}</p>
                    </div>
                  </div>
                </div>

                {idx < steps.length - 1 && (
                  <div
                    aria-hidden="true"
                    class="md:hidden ml-6 mt-3 h-5 w-px bg-border"
                  />
                )}
              </li>
            ))
          }
        </ol>
      </div>

      <div class="mt-8 flex flex-col md:flex-row md:items-center gap-3">
        <a
          href={whatsappHref}
          class="inline-flex items-center justify-center gap-2 rounded-xl px-5 py-3 text-sm font-semibold text-white hover:opacity-95"
          style="background: var(--color-primary);"
        >
          <svg
            class="w-6 h-6"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 640 640"
            fill="currentColor"
            aria-hidden="true"
          >
            <path
              d="M476.9 161.1C435 119.1 379.2 96 319.9 96C197.5 96 97.9 195.6 97.9 318C97.9 357.1 108.1 395.3 127.5 429L96 544L213.7 513.1C246.1 530.8 282.6 540.1 319.8 540.1L319.9 540.1C442.2 540.1 544 440.5 544 318.1C544 258.8 518.8 203.1 476.9 161.1zM319.9 502.7C286.7 502.7 254.2 493.8 225.9 477L219.2 473L149.4 491.3L168 423.2L163.6 416.2C145.1 386.8 135.4 352.9 135.4 318C135.4 216.3 218.2 133.5 320 133.5C369.3 133.5 415.6 152.7 450.4 187.6C485.2 222.5 506.6 268.8 506.5 318.1C506.5 419.9 421.6 502.7 319.9 502.7zM421.1 364.5C415.6 361.7 388.3 348.3 383.2 346.5C378.1 344.6 374.4 343.7 370.7 349.3C367 354.9 356.4 367.3 353.1 371.1C349.9 374.8 346.6 375.3 341.1 372.5C308.5 356.2 287.1 343.4 265.6 306.5C259.9 296.7 271.3 297.4 281.9 276.2C283.7 272.5 282.8 269.3 281.4 266.5C280 263.7 268.9 236.4 264.3 225.3C259.8 214.5 255.2 216 251.8 215.8C248.6 215.6 244.9 215.6 241.2 215.6C237.5 215.6 231.5 217 226.4 222.5C221.3 228.1 207 241.5 207 268.8C207 296.1 226.9 322.5 229.6 326.2C232.4 329.9 268.7 385.9 324.4 410C359.6 425.2 373.4 426.5 391 423.9C401.7 422.3 423.8 410.5 428.4 397.5C433 384.5 433 373.4 431.6 371.1C430.3 368.6 426.6 367.2 421.1 364.5z"
            ></path>
          </svg>
          <span>Cotizar por WhatsApp</span>
        </a>

        <div
          class="flex-1 rounded-xl border border-border bg-surface-alt px-5 py-3 text-sm text-muted-2"
        >
          Tip: si no sabes la medida, envíanos una foto del costado de tu llanta
          y te guiamos.
        </div>
      </div>
    </div>
  </ContentWidth>
</section>
