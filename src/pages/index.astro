import FilterProducts from "../components/home/FilterProducts.astro";
import HowToBuy from "../sections/HowToBuy.astro";
import CTA from "../sections/CTA.astro";
import MapLocation from "../components/home/MapLocation.astro";
---

<BaseLayout title="Facil Car">
